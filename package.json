{
  "name": "pocket-bird-lite",
  "version": "1.0.0",
  "description": "A pixel-art pet bird that flies around the page, lands on elements and can be pet. Stripped-down library build of Pocket Bird by Idrees Hassan.",
  "license": "MPL-2.0",
  "author": "Falyrion",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "LICENSE"
  ],
  "scripts": {
    "sprites": "node scripts/generate-sprites.js",
    "demo": "vite demo",
    "check": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
