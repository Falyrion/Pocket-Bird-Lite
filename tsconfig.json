{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2022", "dom"],
		"types": [],
		"strict": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"skipLibCheck": true
	},
	"include": ["src"]
}
